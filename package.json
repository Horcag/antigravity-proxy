{
  "name": "antigravity-proxy",
  "version": "0.1.0",
  "description": "Headless account-rotating proxy extracted from Antigravity Manager",
  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "type": "module",
  "bin": {
    "antigravity-proxy": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "dev": "node --import tsx src/cli.ts serve",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "quality:file-size": "tsx scripts/quality/check-file-size.ts",
    "quality:ratchet": "tsx scripts/quality/check-file-size.ts --update-baseline",
    "lint:debt": "tsx scripts/quality/check-debt-baseline.ts",
    "lint": "eslint . && npm run lint:debt && npm run quality:file-size",
    "check": "npm run type-check && npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-fastify": "^11.1.18",
    "axios": "^1.15.0",
    "better-sqlite3": "^12.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "fastify": "^5.8.4",
    "lodash-es": "^4.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.16.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@typescript-eslint/parser": "^8.46.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.1.8"
  }
}
