+});
+
+test('CloudCode rejects malformed and unsupported requestType before core invocation', async t => {
+  let calls = 0;
+  const router = createCliproxyRouter({
+    env: { ARINA_CPA_CORE_URL: 'http://127.0.0.1:1', ARINA_CPA_CORE_API_KEY: 'key' },
+    request() { calls++; assert.fail('rejected requestType must not reach core'); },
+  });
+  const gateway = await server(t, router.handleCloudCode);
+  for (const action of ['generateContent', 'streamGenerateContent']) {
+    for (const requestType of [null, false, 0, {}, [], '', ' ', 'web_search', 'image_gen', 'unknown', ' agent ']) {
+      const response = await cloudFetch(gateway + `/v1internal:${action}`, {
+        method: 'POST', headers: cloudHeaders, body: JSON.stringify({ ...envelope, requestType }),
+      });
+      const malformed = typeof requestType !== 'string' || !requestType.trim();
+      assert.equal(response.status, malformed ? 400 : 501);
+      assert.deepEqual(await response.json(), { error: {
+        code: malformed ? 400 : 501,
+        message: malformed ? 'CloudCode requestType must be a non-empty string' :
+          'CloudCode requestType is not supported by this generation route',
+      } });
+    }
+  }
+  assert.equal(calls, 0);
+});
+
+test('CloudCode omitted and agent requestType preserve generation payload and target', async t => {
+  const seen = [];
+  const core = await server(t, async (req, res) => {
+    seen.push({ url: req.url, body: JSON.parse((await body(req)).toString()) }); res.end('{}');
+  });
+  const router = createCliproxyRouter({ env: { ARINA_CPA_CORE_URL: core, ARINA_CPA_CORE_API_KEY: 'key' } });
+  const gateway = await server(t, router.handleCloudCode);
+  for (const action of ['generateContent', 'streamGenerateContent']) {
+    for (const requestType of [undefined, 'agent']) {
+      const response = await cloudFetch(gateway + `/v1internal:${action}`, {
+        method: 'POST', headers: cloudHeaders, body: JSON.stringify({ ...envelope, requestType }),
+      });
+      assert.equal(response.status, 200); assert.deepEqual(await response.json(), { response: {} });
+      assert.deepEqual(seen.at(-1), {
+        url: `/v1beta/models/gemini-test:${action}${action === 'streamGenerateContent' ? '?alt=sse' : ''}`,
+        body: envelope.request,
+      });
+    }
+  }
+  assert.equal(seen.length, 4);
