AG_PROXY_HOST=127.0.0.1
AG_PROXY_PORT=8045
AG_PROXY_API_KEY=replace-with-a-long-random-secret
AG_PROXY_ADMIN_API_KEY=replace-with-a-different-long-random-secret
AG_PROXY_DATA_DIR=./data
# Required for OAuth login and refresh-token renewal. Copy from an authorized client configuration.
AG_PROXY_OAUTH_CLIENT_ID=replace-with-oauth-client-id
AG_PROXY_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
# Optional 64-character hex key. If omitted, a 0600 key file is generated in the data directory.
# AG_PROXY_MASTER_KEY=
